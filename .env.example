# ---- Required in production ----
PORT=3001
NODE_ENV=production

# Persistent volume path (Railway: attach a volume at /data)
DATABASE_PATH=/data/finflow.db

# Signing secret for session tokens. If unset, the app generates one and stores
# it in the database so sessions survive restarts — but set it explicitly so
# tokens stay valid across a database migration.
JWT_SECRET=

# ---- Bootstrap (used only by `npm run seed`) ----
# The seed script refuses to run in production without these.
ADMIN_EMAIL=
ADMIN_PASSWORD=          # minimum 16 characters
ADMIN_NAME=
ADMIN_USERNAME=

# ---- Optional ----
# Comma-separated extra origins allowed to call the API. Same-origin always works.
ALLOWED_ORIGINS=

# Self-service registration is OFF in production unless this is exactly "true".
ALLOW_SELF_REGISTRATION=false

# Where password-reset codes are delivered. If unset, codes are written to the
# server log only — they are NEVER returned in an HTTP response.
RESET_WEBHOOK_URL=
RESET_WEBHOOK_SECRET=

# Key-encryption key for stored bank-provider tokens (bank sync, phase 2).
FINFLOW_KEK_V1=

# Create demo client accounts when seeding. Ignored in production.
SEED_DEMO_DATA=false
